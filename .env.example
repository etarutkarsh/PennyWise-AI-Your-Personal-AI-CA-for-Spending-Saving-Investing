# Copy this file to .env and adjust as needed, then run:
#   docker compose up --build
# docker compose automatically reads a .env file in this directory.

DB_USERNAME=pennywise
DB_PASSWORD=pennywise

# Generate your own for anything beyond local testing, e.g.:
#   openssl rand -base64 48
# Generate with: openssl rand -base64 48
JWT_SECRET=

# AI provider — OmniRoute (free, routes across 290+ providers, no key needed to start).
# Install: npx omni-route  OR  see https://github.com/diegosouzapw/OmniRoute
AI_BASE_URL=http://host.docker.internal:20128/v1
AI_MODEL=auto
OPENAI_API_KEY=

# To use direct OpenAI instead, comment the lines above and uncomment these:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-your-real-key-here

# Fast2SMS key — get free at https://www.fast2sms.com → Dev API
# Leave empty to use dev mode (OTP logged to backend console only).
FAST2SMS_API_KEY=

# Allowed CORS origins (comma-separated). Add your production domain here.
# CORS_ALLOWED_ORIGINS=https://app.pennywise.ai,http://localhost
